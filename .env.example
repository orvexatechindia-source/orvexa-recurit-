# ==============================================================================
# Orvexa Recruit Environment Configuration Example
# Copy this file to .env and configure variables for local development.
# ==============================================================================

# Application general
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Production Domains:
# APP_URL="https://api.orvexatech.online"
# WEB_URL="https://orvexatech.online"

# Database Configuration (Amazon RDS / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/orvexa_recruit?schema=public"

# Authentication / JWT
JWT_SECRET="replace-with-a-secure-32-byte-secret-key-for-local-dev-only"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="replace-with-another-secure-secret-key-for-refresh-token"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS Credentials (for S3 and SES)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="mock-key-for-local-dev"
AWS_SECRET_ACCESS_KEY="mock-secret-for-local-dev"

# AWS S3 Storage Buckets (Encrypted, Private)
AWS_S3_BUCKET_NAME="orvexa-recruit-resumes-dev"

# AWS SES Email configuration
AWS_SES_SENDER_EMAIL="noreply@orvexatech.io"

# Google Gemini API Configuration (Only AI Provider)
GEMINI_API_KEY="AIzaSy...your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-pro"

# Hostinger API Configuration (For DNS/Domain Integration)
HOSTINGER_API_KEY="your-hostinger-api-key"

# Multi-Tenancy Limits / Security
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
