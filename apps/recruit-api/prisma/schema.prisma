datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SaasRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  RECRUITER
  HIRING_MANAGER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  REJECTED
  HIRED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RecommendationStatus {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum CustomFieldEntityType {
  JOB
  CANDIDATE
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DROPDOWN
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  domain       String?       @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  users        User[]
  jobs         Job[]
  candidates   Candidate[]
  applications Application[]
  auditLogs    AuditLog[]
  interviews   Interview[]
  reviews      Review[]
  customFields CustomField[]
  customValues CustomValue[]
  candidateNotes CandidateNote[]
  country            String        @default("US")
  subscriptionPlan   String        @default("FREE") @map("subscription_plan")
  subscriptionStatus String        @default("ACTIVE") @map("subscription_status")
  subscriptionId     String?       @map("subscription_id")
  billingProvider    String?       @map("billing_provider")
  status             String        @default("ACTIVE")
  subscriptionExpiry DateTime?     @map("subscription_expiry")
  gracePeriodDays    Int           @default(7) @map("grace_period_days")

  @@map("tenants")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         SaasRole    @default(CANDIDATE)
  tenantId     String      @map("tenant_id")
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  auditLogs    AuditLog[]
  interviews   Interview[]
  reviews      Review[]
  candidateNotes CandidateNote[]

  @@index([tenantId])
  @@map("users")
}

model Job {
  id           String        @id @default(uuid())
  title        String
  description  String
  requirements String?
  location     String?
  status       JobStatus     @default(DRAFT)
  tenantId     String        @map("tenant_id")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  applications Application[]

  @@index([tenantId])
  @@map("jobs")
}

model Candidate {
  id           String        @id @default(uuid())
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  email        String
  phone        String?
  resumeUrl    String?       @map("resume_url")
  skills       String[]      @default([])
  summary      String?
  tenantId     String        @map("tenant_id")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  applications Application[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("candidates")
}

model Application {
  id          String            @id @default(uuid())
  candidateId String            @map("candidate_id")
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String            @map("job_id")
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status             ApplicationStatus @default(APPLIED)
  matchScore         Int?              @map("match_score")
  fitExplanation     String?           @map("fit_explanation")
  suggestedQuestions String[]          @default([]) @map("suggested_questions")
  tenantId           String            @map("tenant_id")
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  interviews         Interview[]
  reviews            Review[]
  notes              CandidateNote[]
  offerLetter        String?           @map("offer_letter")
  offerStatus        String?           @map("offer_status") // "EXTENDED", "ACCEPTED", "DECLINED"
  signedAt           DateTime?         @map("signed_at")
  signature          String?           @map("signature")

  @@index([tenantId])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  timestamp  DateTime @default(now())
  metadata   Json?

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

model Interview {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId String          @map("application_id")
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId String          @map("interviewer_id")
  interviewer   User            @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  startTime     DateTime        @map("start_time")
  endTime       DateTime        @map("end_time")
  meetingUrl    String?         @map("meeting_url")
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([applicationId])
  @@index([interviewerId])
  @@map("interviews")
}

model Review {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId  String               @map("application_id")
  application    Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId  String               @map("interviewer_id")
  interviewer    User                 @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  rating         Int
  recommendation RecommendationStatus @default(HIRE)
  notes          String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([applicationId])
  @@index([interviewerId])
  @@map("reviews")
}

model CustomField {
  id           String                @id @default(uuid())
  tenantId     String                @map("tenant_id")
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType   CustomFieldEntityType @map("entity_type")
  fieldName    String                @map("field_name")
  fieldType    CustomFieldType       @map("field_type")
  options      String[]              // For dropdown option lists
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  customValues CustomValue[]

  @@unique([tenantId, entityType, fieldName])
  @@index([tenantId])
  @@map("custom_fields")
}

model CustomValue {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityId  String      @map("entity_id") // Links to dynamic Job/Candidate ID
  fieldId   String      @map("field_id")
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([entityId])
  @@index([fieldId])
  @@map("custom_values")
}

model CandidateNote {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String      @map("author_id")
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  message       String
  isInternal    Boolean     @default(true) @map("is_internal")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([applicationId])
  @@index([authorId])
  @@map("candidate_notes")
}

