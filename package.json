{
  "name": "orvexa-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Orvexa Platform - AI-Powered Applicant Tracking System (ATS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev --w @orvexa/recruit-api\" \"npm run dev --w @orvexa/recruit-web\"",
    "start": "npm run start --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5"
  }
}
